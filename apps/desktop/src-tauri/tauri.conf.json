{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dotDock",
  "version": "1.0.2",
  "identifier": "dev.dotdock.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://dotdock-wallpaper.localhost http://dock-icon.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": {
      "../../../assets/wallpapers/*": "wallpapers/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyNzA2OTM0REYyNjcyQ0MKUldUTWNpYmZOR2x3UWxGazlsZlVaUzloZHM2WEs4Q2V1TDFpSElJemt2ZzB5eXdxdlVrdThuWE4K",
      "endpoints": [
        "https://github.com/nAItiklearn/dotDock/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
