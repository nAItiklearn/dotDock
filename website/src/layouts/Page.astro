---
/** Shared shell for the text pages: nav, a headed main area, footer and the page scripts. */
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Band from "../components/Band.astro";
import LiveScene from "../components/LiveScene.astro";
import type { ArtName } from "../lib/art";
import type { SceneName } from "../lib/live-scenes";

interface Props {
  title: string;
  description: string;
  /** Short label above the heading, for example "Download". */
  label: string;
  heading: string;
  /** The pictures above the heading and under the content; each page has its own. */
  artTop: Extract<ArtName, `band-${string}`>;
  artBottom?: Extract<ArtName, `band-${string}`>;
  /** A living scene under the content (components/LiveScene.astro), in place of the bottom picture. */
  sceneBottom?: SceneName;
}
const { title, description, label, heading, artTop, artBottom, sceneBottom } = Astro.props;
---

<Base title={title} description={description}>
  <Nav current={Astro.url.pathname} />
  <main id="main" class="page">
    <Band piece={artTop} />
    <div class="wrap">
      <header class="page__head">
        <p class="caps caps-row caps--text"><span class="dot" aria-hidden="true"></span>{label}</p>
        <h1 class="page__title">{heading}</h1>
        <p class="lede"><slot name="lede" /></p>
      </header>
      <div class="page__body">
        <slot />
      </div>
    </div>
    {sceneBottom ? <LiveScene scene={sceneBottom} /> : artBottom && <Band piece={artBottom} />}
  </main>
  <Footer />

  <script>
    import "../scripts/chrome";
    import "../scripts/theme";
  </script>
</Base>
