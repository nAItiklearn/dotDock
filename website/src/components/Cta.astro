---
import { LICENSE_SPDX, PRODUCT_NAME, REPO_URL, ROUTES, NEXT_RELEASE } from "../brand";
import { releaseView, type ReleaseData } from "../lib/release";
import releaseData from "../data/release.json";

const release = releaseView(releaseData as ReleaseData | null, NEXT_RELEASE);
---

<section class="section" id="get" aria-labelledby="get-title">
  <div class="wrap">
    <div class="cta reveal">
      <h2 class="cta__title" id="get-title">Make Windows <span class="hero__dots">yours</span>.</h2>
      <div class="cta__actions">
        <a class="btn btn--accent btn--lg" href={ROUTES.download}>Download for Windows</a>
        <a class="btn btn--lg btn--quiet" href={REPO_URL} rel="noopener">View on GitHub</a>
      </div>
      <p class="caps caps-row cta__status">
        <span class="dot" aria-hidden="true"></span>
        {`${PRODUCT_NAME} ${release.version}. Free and open source, ${LICENSE_SPDX}.`}
      </p>
    </div>
  </div>
</section>
