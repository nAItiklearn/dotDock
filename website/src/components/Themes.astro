---
import SectionHead from "./SectionHead.astro";
import { THEMES } from "../lib/themes";
import { WALLPAPERS } from "../lib/wallpapers";

const chips = [
  { role: "Background", key: "bg" },
  { role: "Surface", key: "surface2" },
  { role: "Text", key: "text" },
  { role: "Accent", key: "accent" },
] as const;
---

<section class="section" id="themes" aria-labelledby="themes-title">
  <div class="wrap">
    <SectionHead index="03" label="Themes" titleId="themes-title">
      <Fragment slot="title">Three themes. <span class="dim">One accent each.</span></Fragment>
      <Fragment slot="lede">
        Obsidian, Paper and Aurum are the app's built-in themes. Pick one and <strong>this whole page changes with
        it</strong>, because the page runs on the same colour tokens as the app.
      </Fragment>
    </SectionHead>

    <div class="theme-cards needs-js" role="radiogroup" aria-label="Colour theme" data-theme-cards>
      {
        THEMES.map((t, i) => (
          <div class="theme-slot reveal" style={`--i:${i}`}>
          <div class="theme-card" data-theme={t.id}>
            <button type="button" class="theme-card__btn" role="radio" aria-checked="false" tabindex="-1" data-theme-set={t.id}>
              <span class="theme-card__preview" aria-hidden="true">
                <img src={WALLPAPERS[t.id].small} width="640" height="360" alt="" loading="lazy" decoding="async" />
                <span class="theme-card__clock">
                  <svg class="dm" data-live-clock-svg="blocks" viewBox="0 0 17 5">
                    <path fill="currentColor"></path>
                  </svg>
                </span>
                <span class="theme-card__ring">
                  <svg class="ring" viewBox="0 0 100 100">
                    <circle class="ring__track" cx="50" cy="50" r="44" />
                    <circle class="ring__value" cx="50" cy="50" r="44" stroke-dasharray="276.46" stroke-dashoffset="100" />
                  </svg>
                </span>
              </span>
              <span class="theme-card__row">
                <span class="theme-card__name">{t.name}</span>
                <span class="caps theme-card__state">
                  <span class="dot" aria-hidden="true"></span>
                  <span data-state-label data-mode={t.mode === "dark" ? "Dark" : "Light"}>{t.mode === "dark" ? "Dark" : "Light"}</span>
                </span>
              </span>
              <span class="theme-card__blurb">{t.blurb}</span>
              <span class="theme-card__chips">
                {chips.map((c) => (
                  <span class="chip">
                    <span class="chip__swatch" style={`background:${t.colors[c.key]}`}></span>
                    <span class="chip__text">
                      <span class="caps">{c.role}</span>
                      <span class="chip__hex">{t.colors[c.key]}</span>
                    </span>
                  </span>
                ))}
              </span>
            </button>
          </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
