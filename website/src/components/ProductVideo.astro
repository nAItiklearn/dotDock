---
/**
 * Slot for the product video (launcher, dock, notch). With no video configured it shows an animated
 * dot-matrix poster that says so plainly; with PRODUCT_VIDEO set (src/video.ts) the same frame holds
 * a real <video>. Nothing here pretends to play.
 */
import { PRODUCT_VIDEO } from "../video";

const COLS = 32;
const ROWS = 18;

/** Filled rectangle of lattice cells with the four corner cells removed, so it reads as a pill. */
function pill(x0: number, y0: number, x1: number, y1: number): [number, number][] {
  const out: [number, number][] = [];
  for (let y = y0; y <= y1; y++) {
    for (let x = x0; x <= x1; x++) {
      const corner = (x === x0 || x === x1) && (y === y0 || y === y1);
      if (!corner) out.push([x, y]);
    }
  }
  return out;
}

/** Outline of a rectangle, one cell thick, corners removed. */
function frame(x0: number, y0: number, x1: number, y1: number): [number, number][] {
  const out: [number, number][] = [];
  for (let y = y0; y <= y1; y++) {
    for (let x = x0; x <= x1; x++) {
      const edge = x === x0 || x === x1 || y === y0 || y === y1;
      const corner = (x === x0 || x === x1) && (y === y0 || y === y1);
      if (edge && !corner) out.push([x, y]);
    }
  }
  return out;
}

function path(cells: readonly [number, number][], r: number): string {
  return cells
    .map(([x, y]) => `M${x + 0.5 - r} ${y + 0.5}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0Z`)
    .join("");
}

const groups = [
  {
    id: "launcher",
    label: "Launcher",
    // A search field and two result rows inside a frame.
    cells: [
      ...frame(9, 5, 22, 12),
      ...pill(11, 7, 20, 7),
      ...pill(11, 9, 14, 9),
      ...pill(16, 9, 20, 9),
      ...pill(11, 10, 14, 10),
      ...pill(16, 10, 20, 10),
    ],
  },
  { id: "dock", label: "Dock", cells: pill(7, 15, 24, 16) },
  { id: "notch", label: "Notch", cells: pill(12, 1, 19, 2) },
] as const;
---

<figure class="video reveal" data-product-video>
  <div class="video__frame">
    {
      PRODUCT_VIDEO ? (
        <video class="video__player" controls preload="none" playsinline poster={PRODUCT_VIDEO.poster} aria-label={PRODUCT_VIDEO.label}>
          <source src={PRODUCT_VIDEO.src} type="video/mp4" />
          {PRODUCT_VIDEO.captions && <track kind="captions" src={PRODUCT_VIDEO.captions} srclang="en" label="English" default />}
        </video>
      ) : (
        <>
          <svg class="video__poster" viewBox={`0 0 ${COLS} ${ROWS}`} aria-hidden="true" preserveAspectRatio="xMidYMid slice">
            <defs>
              <pattern id="video-lattice" width="1" height="1" patternUnits="userSpaceOnUse">
                <circle cx="0.5" cy="0.5" r="0.07" class="video__off" />
              </pattern>
            </defs>
            <rect width={COLS} height={ROWS} fill="url(#video-lattice)" />
            {groups.map((g, i) => <path class="video__group" style={`--i:${i}`} d={path(g.cells, 0.36)} />)}
          </svg>
          <p class="caps caps-row video__badge"><span class="dot dot--hollow" aria-hidden="true"></span>Product video, coming soon</p>
        </>
      )
    }
  </div>
  <figcaption class="video__caption">
    {
      PRODUCT_VIDEO ? (
        <span class="caps">{PRODUCT_VIDEO.label}</span>
      ) : (
        <>
          <ul class="video__legend caps" aria-label="What the video will show">
            {groups.map((g, i) => <li class="video__tag" style={`--i:${i}`}><span class="dot" aria-hidden="true"></span>{g.label}</li>)}
          </ul>
          <p class="video__note">A short tour is being recorded. Until then, this is where each part lives on screen.</p>
        </>
      )
    }
  </figcaption>
</figure>
