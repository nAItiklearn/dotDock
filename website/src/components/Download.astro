---
import SectionHead from "./SectionHead.astro";
import { LATEST_RELEASE, PRODUCT_NAME, RELEASES_URL, REPO_URL } from "../brand";
---

<section class="section" id="download" aria-labelledby="download-title">
  <div class="wrap">
    <SectionHead index="07" label="Download" titleId="download-title">
      <Fragment slot="title">
        {LATEST_RELEASE ? <>Get {PRODUCT_NAME} {LATEST_RELEASE.tag}.</> : <>Not released yet. <span class="dim">Honestly.</span></>}
      </Fragment>
      <Fragment slot="lede">
        {
          LATEST_RELEASE
            ? <>Installers and the portable build are on GitHub Releases.</>
            : <>There is nothing to download today, and this page will not pretend otherwise. Releases are published on GitHub, so that is where the first one will appear.</>
        }
      </Fragment>
    </SectionHead>

    <div class="download reveal">
      <div class="download__status">
        <p class="caps caps-row caps--text">
          <span class={LATEST_RELEASE ? "dot" : "dot dot--hollow"} aria-hidden="true"></span>
          {LATEST_RELEASE ? "Latest release" : "Status"}
        </p>
        <p class="download__word" aria-hidden="true">{LATEST_RELEASE ? LATEST_RELEASE.tag : "Soon"}</p>
      </div>

      <div class="download__body">
        <dl class="specs">
          <div class="specs__row"><dt class="caps">For</dt><dd>Windows 10 22H2 and Windows 11</dd></div>
          <div class="specs__row"><dt class="caps">Price</dt><dd>Free</dd></div>
          <div class="specs__row"><dt class="caps">Planned</dt><dd>Per-user installer, no admin rights, plus a portable zip</dd></div>
        </dl>
        <div class="download__actions">
          <a class="btn btn--primary" href={LATEST_RELEASE ? LATEST_RELEASE.url : RELEASES_URL} rel="noopener">
            {LATEST_RELEASE ? "Open the release" : "Open GitHub Releases"}
            <svg class="btn__arrow" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3.5 10.5l7-7M4.5 3.5h6v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a class="btn" href={REPO_URL} rel="noopener">Watch the repository</a>
        </div>
        <p class="download__hint">On GitHub, choose Watch, then Custom, then Releases, and you will be told when it lands.</p>
      </div>
    </div>
  </div>
</section>
