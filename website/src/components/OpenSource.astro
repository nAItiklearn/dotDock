---
import SectionHead from "./SectionHead.astro";
import { ISSUES_URL, LICENSE_SPDX, LICENSE_URL, PRODUCT_NAME, REPO_URL } from "../brand";

const CLONE = `git clone ${REPO_URL}.git`;

const facts = [
  {
    label: "Licence",
    value: LICENSE_SPDX,
    body: "Read it, change it, share it. Anything built from it stays open, so it cannot be closed up and resold.",
  },
  {
    label: "Network",
    value: "Two calls, both optional",
    body: "A weather forecast from Open-Meteo, only if you use the weather widget, and an update check you can turn off. No account, no analytics, no crash upload.",
  },
  {
    label: "Data",
    value: "Plain files, on your PC",
    body: "Themes, layouts and wallpapers are data you can edit, export and share, not code you have to rebuild.",
  },
];
---

<section class="section" id="source" aria-labelledby="source-title">
  <div class="wrap">
    <SectionHead index="06" label="Open source" titleId="source-title">
      <Fragment slot="title">Free, <span class="dim">and it stays free.</span></Fragment>
      <Fragment slot="lede">
        {PRODUCT_NAME} is open source under the <strong>{LICENSE_SPDX}</strong> licence. The code, the design
        tokens and the issue tracker are all in one public repository.
      </Fragment>
    </SectionHead>

    <dl class="facts">
      {
        facts.map((f, i) => (
          <div class="fact reveal" style={`--i:${i}`}>
            <dt class="caps caps-row caps--text"><span class="dot" aria-hidden="true"></span>{f.label}</dt>
            <dd class="fact__value">{f.value}</dd>
            <dd class="fact__body">{f.body}</dd>
          </div>
        ))
      }
    </dl>

    <div class="source-actions reveal">
      <div class="code code--wide">
        <code class="code__text"><span class="code__prompt" aria-hidden="true">$</span> {CLONE}</code>
        <button type="button" class="code__copy needs-js" data-copy={CLONE}>Copy</button>
      </div>
      <div class="source-actions__links">
        <a class="btn btn--primary" href={REPO_URL} rel="noopener">
          View the source
          <svg class="btn__arrow" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3.5 10.5l7-7M4.5 3.5h6v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="btn" href={ISSUES_URL} rel="noopener">Report an issue</a>
        <a class="btn" href={LICENSE_URL} rel="noopener">Read the licence</a>
      </div>
    </div>
  </div>
</section>
