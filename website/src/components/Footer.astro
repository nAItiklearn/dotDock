---
import {
  DISCLAIMER,
  ISSUES_URL,
  LICENSE_SPDX,
  OPEN_METEO_URL,
  PRODUCT_NAME,
  RELEASES_URL,
  REPO_URL,
  ROUTES,
} from "../brand";
import LiveScene from "./LiveScene.astro";
import Mark from "./Mark.astro";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Product",
    links: [
      { href: ROUTES.features, label: "Features" },
      { href: `${ROUTES.home}#widgets`, label: "Widgets" },
      { href: `${ROUTES.home}#themes`, label: "Themes" },
      { href: `${ROUTES.home}#startup`, label: "Startup" },
      { href: ROUTES.download, label: "Download" },
    ],
  },
  {
    title: "Resources",
    links: [
      { href: ROUTES.faq, label: "FAQ" },
      { href: ROUTES.changelog, label: "Changelog" },
      { href: REPO_URL, label: "GitHub", external: true },
      { href: RELEASES_URL, label: "Releases", external: true },
      { href: ISSUES_URL, label: "Issues", external: true },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: ROUTES.privacy, label: "Privacy" },
      { href: ROUTES.license, label: "Licence and notices" },
    ],
  },
] as const;
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__about">
        <a class="wordmark footer__lockup" href={ROUTES.home} aria-label={`${PRODUCT_NAME}, home`}>
          <Mark size={34} />
          <span class="wordmark__text">{PRODUCT_NAME}</span>
        </a>
        <p>A free, open-source desktop environment for Windows, drawn in dots. No account, no telemetry, no cookies on this site.</p>
      </div>
      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <h2 class="footer__title">{col.title}</h2>
            <ul class="footer__list">
              {
                col.links.map((l) => (
                  <li>
                    <a href={l.href} rel={"external" in l ? "noopener" : undefined}>{l.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="footer__stage" aria-hidden="true">
    <span class="footer__mark"><Mark size={48} class="footer__mark-icon" />{PRODUCT_NAME}</span>
  </div>

  <div class="wrap">
    <div class="footer__legal">
      <p>{DISCLAIMER}</p>
      <p>
        {LICENSE_SPDX} &middot; Fonts SIL OFL 1.1 &middot; Weather data by
        <a href={OPEN_METEO_URL} rel="noopener">Open-Meteo</a> (CC BY 4.0)
      </p>
      <p class="tabular">&copy; {year} {PRODUCT_NAME} contributors</p>
    </div>
  </div>

  <!-- The meadow ends the page: its ground runs to the bottom edge, with nothing under it. -->
  <div class="footer__meadow" aria-hidden="true">
    <LiveScene scene="meadow" />
  </div>
</footer>
