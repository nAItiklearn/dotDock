---
import SectionHead from "./SectionHead.astro";
import Widget from "./Widget.astro";

const cards = [
  {
    id: "time",
    title: "Time",
    line: "Three clock styles, a date and a month, always in step with your PC.",
    wide: true,
    items: [
      { kind: "clock", style: "dots", place: "--w:4" },
      { kind: "clock", style: "blocks", place: "--w:4" },
      { kind: "clock", style: "stripes", place: "--w:4" },
      { kind: "date" },
      { kind: "calendar" },
    ],
  },
  {
    id: "system",
    title: "System",
    line: "Battery, memory and disk at a glance, as rings and dot grids.",
    items: [{ kind: "ring" }, { kind: "ram" }, { kind: "disk" }, { kind: "batpill" }],
  },
  {
    id: "media",
    title: "Media",
    line: "What is playing, with controls, from any player on your PC.",
    items: [{ kind: "music" }],
  },
  {
    id: "photo",
    title: "Photo",
    line: "Your own picture in a frame, filled or fitted, in colour or black and white.",
    items: [{ kind: "photo" }],
  },
  {
    id: "focus",
    title: "Focus",
    line: "A timer that really counts, and a list that really ticks.",
    items: [{ kind: "timer" }, { kind: "todo" }],
  },
  {
    id: "weather",
    title: "Weather",
    line: "The forecast for the place you choose, from Open-Meteo.",
    items: [{ kind: "weather" }, { kind: "forecast" }],
  },
] as const;
---

<section class="section" id="widgets" aria-labelledby="widgets-title">
  <div class="wrap">
    <SectionHead label="The home screen" titleId="widgets-title">
      <Fragment slot="title">Made to be <span class="dim">glanced at.</span></Fragment>
      <Fragment slot="lede">
        Time, date, calendar, battery and the timer are live on this page and read only this device. A hollow dot marks a sample value.
      </Fragment>
    </SectionHead>

    <div class="wcards">
      {
        cards.map((card, i) => (
          <article class={`wcard reveal${"wide" in card ? " wcard--wide" : ""}`} style={`--i:${i % 2}`} aria-labelledby={`wc-${card.id}`}>
            <header class="wcard__head">
              <h3 class="wcard__title" id={`wc-${card.id}`}>{card.title}</h3>
              <p class="wcard__line">{card.line}</p>
            </header>
            <div class="cluster wcard__cluster">
              {
                card.items.map((item) => (
                  <Widget
                    kind={item.kind}
                    place={"place" in item ? item.place : ""}
                    clockStyle={"style" in item ? item.style : "blocks"}
                  />
                ))
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
