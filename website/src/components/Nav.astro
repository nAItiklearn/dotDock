---
import { PRODUCT_NAME, REPO_URL, ROUTES } from "../brand";
import { THEMES } from "../lib/themes";
import Mark from "./Mark.astro";

interface Props {
  /** Pathname of the page being rendered, to mark the current link. */
  current?: string;
}
const { current = ROUTES.home } = Astro.props;

const links = [
  { href: ROUTES.features, label: "Features" },
  { href: `${ROUTES.home}#widgets`, label: "Widgets" },
  { href: `${ROUTES.home}#themes`, label: "Themes" },
  { href: ROUTES.faq, label: "FAQ" },
];
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="wordmark" href={ROUTES.home} aria-label={`${PRODUCT_NAME}, home`}>
      <Mark size={28} />
      <span class="wordmark__text">{PRODUCT_NAME}</span>
    </a>

    <nav aria-label="Main">
      <ul class="nav__links caps">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.href === current ? "page" : undefined}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__tools">
      <a class="nav__github" href={REPO_URL} rel="noopener" aria-label={`${PRODUCT_NAME} on GitHub`} title="View the source on GitHub">
        <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
      <div class="theme-switch needs-js" role="radiogroup" aria-label="Colour theme" data-theme-switch>
        {
          THEMES.map((t) => (
            <button
              type="button"
              class="theme-switch__opt"
              role="radio"
              aria-checked="false"
              aria-label={`${t.name}, ${t.mode}`}
              title={t.name}
              data-theme-set={t.id}
              tabindex="-1"
            >
              <span class="theme-switch__swatch" data-theme={t.id} aria-hidden="true" />
            </button>
          ))
        }
      </div>
      <details class="nav__menu" data-nav-menu>
        <summary class="nav__menu-button" aria-label="Menu">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
            <g fill="currentColor"><circle cx="4" cy="4" r="1.6" /><circle cx="12" cy="4" r="1.6" /><circle cx="4" cy="12" r="1.6" /><circle cx="12" cy="12" r="1.6" /></g>
          </svg>
        </summary>
        <ul class="nav__sheet">
          {
            links.map((l) => (
              <li>
                <a href={l.href} aria-current={l.href === current ? "page" : undefined}>{l.label}</a>
              </li>
            ))
          }
          <li><a href={ROUTES.download}>Download</a></li>
        </ul>
      </details>
      <a class="btn btn--accent nav__cta" href={ROUTES.download} aria-current={current === ROUTES.download ? "page" : undefined}>Download</a>
    </div>
  </div>
</header>
