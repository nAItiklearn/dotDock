---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import WhatItIs from "../components/WhatItIs.astro";
import Widgets from "../components/Widgets.astro";
import Themes from "../components/Themes.astro";
import Boot from "../components/Boot.astro";
import Safety from "../components/Safety.astro";
import OpenSource from "../components/OpenSource.astro";
import Download from "../components/Download.astro";
import Footer from "../components/Footer.astro";
import { LICENSE_SPDX, PRODUCT_NAME, TAGLINE } from "../brand";

const title = `${PRODUCT_NAME}: ${TAGLINE}`;
const description = `${PRODUCT_NAME} is a free, open-source desktop for Windows: a dot-matrix clock and widgets over an original wallpaper, and one click back to stock Windows. ${LICENSE_SPDX}.`;
---

<Base title={title} description={description}>
  <Nav />
  <main id="main">
    <Hero />
    <WhatItIs />
    <Widgets />
    <Themes />
    <Boot />
    <Safety />
    <OpenSource />
    <Download />
  </main>
  <Footer />

  <script>
    import "../scripts/hero-field";
  </script>
  <script>
    import "../scripts/chrome";
    import "../scripts/theme";
    import "../scripts/live";
    import "../scripts/safety";
  </script>
</Base>
