---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import VideoSlot from "../components/VideoSlot.astro";
import Band from "../components/Band.astro";
import LiveScene from "../components/LiveScene.astro";
import WidgetCards from "../components/WidgetCards.astro";
import Customize from "../components/Customize.astro";
import Wall from "../components/Wall.astro";
import Boot from "../components/Boot.astro";
import Safety from "../components/Safety.astro";
import FaqSection from "../components/FaqSection.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import { LICENSE_SPDX, PRODUCT_NAME, TAGLINE } from "../brand";

const title = `${PRODUCT_NAME}: ${TAGLINE}`;
const description = `${PRODUCT_NAME} is a free, open-source desktop environment for Windows: a living home screen, a dock and an agent island, on a native Rust core with no telemetry. ${LICENSE_SPDX}.`;
---

<Base title={title} description={description} structuredData>
  <Nav />
  <main id="main">
    <Hero />
    <VideoSlot variant="stage" name="tour" label="A tour of dotDock: the home screen, the dock and the island" />
    <Features />
    <Band piece="band-meadow" />
    <WidgetCards />
    <Customize />
    <Wall />
    <LiveScene scene="paddock" />
    <Boot />
    <Safety />
    <Band piece="band-octopus" />
    <FaqSection />
    <Cta />
  </main>
  <Footer />

  <script>
    import "../scripts/chrome";
    import "../scripts/theme";
    import "../scripts/live";
    import "../scripts/island";
    import "../scripts/safety";
    import "../scripts/parallax";
  </script>
</Base>
