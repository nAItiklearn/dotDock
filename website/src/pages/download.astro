---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Vista from "../components/download/Vista.astro";
import GithubMark from "../components/download/GithubMark.astro";
import { PRODUCT_NAME, RELEASES_URL, REPO_URL, ROUTES, WEBVIEW2_URL } from "../brand";
import { releaseView, type ReleaseData } from "../lib/release";
import releaseData from "../data/release.json";
import "../styles/download.css";

const release = releaseView(releaseData as ReleaseData | null);
const released = release.state === "released";
const CLONE = `git clone ${REPO_URL}.git`;
const down = "M7 2v8M3.5 6.5L7 10l3.5-3.5M2.5 12.5h9";
---

<Base
  title={`Download ${PRODUCT_NAME} for Windows`}
  description={`Get ${PRODUCT_NAME}, the desktop environment for Windows: what it needs, what the installer changes, and how to put your original desktop back. Releases are published on GitHub.`}
>
  <Nav current={ROUTES.download} />
  <main id="main" class="dl">
    <section class="dl-head wrap" aria-labelledby="dl-title">
      <p class="caps caps-row caps--text">
        <span class={released ? "dot" : "dot dot--hollow"} aria-hidden="true"></span>
        {released ? "Latest release" : "Download · In development"}
      </p>
      {
        release.state === "released" ? (
          <>
            <h1 class="h2 h1" id="dl-title">{PRODUCT_NAME} {release.version}</h1>
            <p class="lede">
              Released <time datetime={release.dateTime}>{release.date}</time>. One installer for Windows 10 and 11, set up in
              your own account, with no administrator rights needed.
            </p>
            <div class="dl-head__actions">
              <a class="btn btn--primary btn--lg" href={release.downloadUrl} rel="noopener" data-release-download>
                <svg class="btn__arrow" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d={down} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Download for Windows
              </a>
              <a class="btn btn--lg" href={release.pageUrl} rel="noopener">
                <GithubMark />
                Release notes
              </a>
            </div>
            <dl class="dl-file" data-release-file>
              <div class="dl-file__row"><dt>File</dt><dd>{release.fileName}</dd></div>
              <div class="dl-file__row"><dt>Size</dt><dd data-release-size>{release.size}</dd></div>
              <div class="dl-file__sha">
                <dt>SHA-256</dt>
                <dd class="code">
                  <code class="code__text" data-release-sha>{release.sha256}</code>
                  <button type="button" class="code__copy needs-js" data-copy={release.sha256}>Copy</button>
                </dd>
              </div>
            </dl>
          </>
        ) : (
          <>
            <h1 class="h2 h1" id="dl-title">Not released yet.</h1>
            <p class="lede">
              {PRODUCT_NAME} is still being built and tested, so there is nothing to install today. The first release will be
              published on GitHub, and this page will show its version, size and checksum as soon as it is.
            </p>
            <div class="dl-head__actions">
              <a class="btn btn--primary btn--lg" href={REPO_URL} rel="noopener">
                <GithubMark />
                Watch the GitHub releases
              </a>
              <a class="btn btn--lg" href="#source">Build it from source</a>
            </div>
            <p class="caps dl-head__hint">
              On the repository page choose Watch, then Custom, then Releases. GitHub sends one notice when a release is out.
            </p>
          </>
        )
      }
    </section>

    <Vista />

    <section class="dl-facts wrap" aria-labelledby="dl-before">
      <header class="dl-facts__head">
        <p class="note">Before you install</p>
        <h2 class="h2" id="dl-before">What it needs, what it changes, <span class="dim">and how to undo it.</span></h2>
      </header>
      <div class="dl-cols">
        <article class="dl-col reveal" aria-labelledby="dl-needs">
          <h3 class="dl-col__title" id="dl-needs">What it needs</h3>
          <dl class="dl-needs">
            <div><dt>Windows</dt><dd>Windows 10 22H2, or Windows 11.</dd></div>
            <div><dt>Processor</dt><dd>64-bit (x64), Intel or AMD.</dd></div>
            <div>
              <dt>Runtime</dt>
              <dd>
                Microsoft Edge WebView2. It is part of Windows 11 and comes with Edge on current Windows 10; if it is missing,
                install the Evergreen runtime from <a href={WEBVIEW2_URL} rel="noopener">Microsoft</a>.
              </dd>
            </div>
            <div><dt>Rights</dt><dd>Your own account. Nothing asks for administrator rights.</dd></div>
            {release.state === "released" && <div><dt>Installer</dt><dd>{release.size}</dd></div>}
          </dl>
        </article>

        <article class="dl-col reveal" aria-labelledby="dl-does">
          <h3 class="dl-col__title" id="dl-does">What the installer does</h3>
          <ol class="dl-steps">
            <li><span>Installs {PRODUCT_NAME} for your account only. Other users of the PC are not touched.</span></li>
            <li><span>Saves a snapshot of your wallpaper, desktop icons and startup settings <strong>before it changes anything</strong>.</span></li>
            <li><span>Sets the theme and wallpaper you pick, shows the widgets and puts the dock where the taskbar was. The taskbar is hidden, never removed.</span></li>
            <li><span>Adds one sign-in entry, so your desktop is in place when you sign in.</span></li>
          </ol>
          <p class="dl-aside">
            <strong>SmartScreen.</strong> Early builds may not be code-signed, so Windows can show &ldquo;Windows protected
            your PC&rdquo;. If the file came from the official <a href={RELEASES_URL} rel="noopener">GitHub Releases</a> page,
            choose More info, then Run anyway. If it came from anywhere else, do not run it.
          </p>
        </article>

        <article class="dl-col reveal" aria-labelledby="dl-undo">
          <h3 class="dl-col__title" id="dl-undo">How to undo it</h3>
          <div class="dl-undo">
            <p>
              <strong>Use Windows desktop</strong>, in Settings, puts back your wallpaper, desktop icons, taskbar and startup
              settings from the snapshot. Your {PRODUCT_NAME} settings are kept in case you come back.
            </p>
            <p>
              <strong>Uninstalling</strong> from Windows Settings, Apps, runs the same restore first, so Windows is left as it
              was before.
            </p>
            <p>
              <strong>If the app will not start</strong>, the repository's restore tool, <code>tools/restore-windows.ps1</code>,
              does the same on its own. See <a href={`${ROUTES.faq}#restore`}>the FAQ</a>.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="dl-source wrap reveal" id="source" aria-labelledby="dl-source-title">
      <p class="note">Build it yourself</p>
      <h2 class="dl-col__title" id="dl-source-title">The source is public.</h2>
      <p class="lede">Clone it, then follow the README in the repository.</p>
      <div class="code">
        <code class="code__text"><span class="code__prompt" aria-hidden="true">$</span> {CLONE}</code>
        <button type="button" class="code__copy needs-js" data-copy={CLONE}>Copy</button>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    import "../scripts/chrome";
    import "../scripts/theme";
  </script>
</Base>
